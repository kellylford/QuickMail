<Window x:Class="QuickMail.Views.AddAccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Add Account"
        Height="640" Width="440"
        MinHeight="540" MinWidth="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Loaded="Window_Loaded"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}"
        FontSize="{DynamicResource Theme.FontSizeBase}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Provider first: choosing it fills in every server setting below, which is what
                     keeps the Advanced expander closed for the common cases. -->
                <Label x:Name="LblProvider" Content="_Provider:" Target="{Binding ElementName=ProviderComboBox}" Padding="0" Margin="0,0,0,2"/>
                <ComboBox x:Name="ProviderComboBox"
                          ItemsSource="{Binding Providers}"
                          SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                          AutomationProperties.LabeledBy="{Binding ElementName=LblProvider}"
                          AutomationProperties.Name="Provider"
                          TabIndex="0"/>

                <Label x:Name="LblUsername" Content="_Email address:" Target="{Binding ElementName=UsernameBox}" Padding="0" Margin="0,10,0,2"/>
                <TextBox x:Name="UsernameBox"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.LabeledBy="{Binding ElementName=LblUsername}"
                         LostFocus="UsernameBox_LostFocus"
                         TabIndex="1"/>

                <!-- Password (hidden for OAuth2) -->
                <StackPanel Visibility="{Binding IsPasswordAuth, Converter={StaticResource BoolToVisibility}}">
                    <Label x:Name="LblPassword" Content="Pass_word:" Target="{Binding ElementName=PasswordBox}" Padding="0" Margin="0,10,0,2"/>
                    <PasswordBox x:Name="PasswordBox"
                                 AutomationProperties.LabeledBy="{Binding ElementName=LblPassword}"
                                 AutomationProperties.HelpText="Password is stored in Windows Credential Manager"
                                 TabIndex="2"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>

                    <!-- App-specific password warning, driven by the selected provider (Gmail, Yahoo,
                         iCloud). The same text is announced as a Hint when the provider changes, so it
                         is deliberately not duplicated into any AutomationProperties.Name. -->
                    <Border Visibility="{Binding ShowAppPasswordHint, Converter={StaticResource BoolToVisibility}}"
                            Background="{DynamicResource Theme.WarningBackground}"
                            BorderBrush="{DynamicResource Theme.Warning}"
                            BorderThickness="1"
                            Padding="8,6"
                            Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding AppPasswordHint}"
                                       TextWrapping="Wrap"
                                       FontWeight="SemiBold"/>
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                                <Hyperlink NavigateUri="{Binding AppPasswordUrl}" KeyboardNavigation.TabIndex="2"
                                           RequestNavigate="AppPasswordLink_RequestNavigate"
                                           AutomationProperties.Name="Create an app password">
                                    <Run Text="{Binding AppPasswordUrl, Mode=OneWay}"/>
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Label x:Name="LblAccountName" Content="Account _name:" Target="{Binding ElementName=AccountNameBox}" Padding="0" Margin="0,10,0,2"/>
                <TextBox x:Name="AccountNameBox"
                         Text="{Binding AccountName, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.LabeledBy="{Binding ElementName=LblAccountName}"
                         AutomationProperties.HelpText="What this account is called inside QuickMail"
                         TabIndex="3"/>

                <Label x:Name="LblDisplayName" Content="Sender _display name:" Target="{Binding ElementName=DisplayNameBox}" Padding="0" Margin="0,8,0,2"/>
                <TextBox x:Name="DisplayNameBox"
                         Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.LabeledBy="{Binding ElementName=LblDisplayName}"
                         AutomationProperties.HelpText="The name recipients see on messages you send"
                         TabIndex="4"/>

                <!-- Sync opt-ins stay on the main surface: they must be checked BEFORE sign-in so the
                     permission is part of the same consent (#256, #282). -->
                <CheckBox Content="Sync _contacts from this account"
                          Visibility="{Binding ShowContactSyncOption, Converter={StaticResource BoolToVisibility}}"
                          IsChecked="{Binding SyncContacts, Mode=TwoWay}"
                          AutomationProperties.Name="Sync contacts from this account"
                          AutomationProperties.HelpText="Check this before signing in to also grant read-only permission to read your contacts into the address book."
                          Margin="0,12,0,0" TabIndex="5"/>

                <CheckBox Content="Sync ca_lendar from this account"
                          Visibility="{Binding ShowCalendarSyncOption, Converter={StaticResource BoolToVisibility}}"
                          IsChecked="{Binding SyncCalendar, Mode=TwoWay}"
                          AutomationProperties.Name="Sync calendar from this account"
                          AutomationProperties.HelpText="Show this account's calendar in the Calendar view. For Microsoft, grants calendar permission when you sign in; for iCloud, uses your app-specific password."
                          Margin="0,6,0,0" TabIndex="6"/>

                <!-- OAuth sign-in stays on the main surface too: for an OAuth provider this is the
                     primary action, not an advanced one. -->
                <Button Content="Sign in _with Microsoft…"
                        Visibility="{Binding IsOAuth2, Converter={StaticResource BoolToVisibility}}"
                        Command="{Binding SignInMicrosoftCommand}"
                        AutomationProperties.Name="Sign in with Microsoft"
                        HorizontalAlignment="Left" MinWidth="200" Margin="0,10,0,0" TabIndex="7"/>

                <Button Content="Sign in _with Google…"
                        Visibility="{Binding IsGoogleOAuth, Converter={StaticResource BoolToVisibility}}"
                        Command="{Binding SignInGoogleCommand}"
                        AutomationProperties.Name="Sign in with Google"
                        HorizontalAlignment="Left" MinWidth="200" Margin="0,10,0,0" TabIndex="8"/>

                <!-- Everything a recognized provider already answers for the user. Collapsed unless
                     the provider is "Other" or discovery came back empty (VM.IsAdvancedExpanded). -->
                <Expander x:Name="AdvancedExpander"
                          Header="Ad_vanced settings"
                          IsExpanded="{Binding IsAdvancedExpanded, Mode=TwoWay}"
                          AutomationProperties.Name="Advanced settings"
                          Margin="0,14,0,0"
                          TabIndex="9">
                    <StackPanel Margin="0,8,0,0">

                        <!-- Connection method: only Microsoft has more than one, so only Microsoft is
                             asked. Hidden entirely when the Graph feature gate is off. -->
                        <StackPanel Visibility="{Binding ShowConnectionMethod, Converter={StaticResource BoolToVisibility}}">
                            <Label x:Name="LblBackend" Content="Connection _method:" Target="{Binding ElementName=BackendComboBox}" Padding="0" Margin="0,0,0,2"/>
                            <ComboBox x:Name="BackendComboBox"
                                      ItemsSource="{Binding AvailableBackends}"
                                      SelectedItem="{Binding SelectedBackend, Mode=TwoWay}"
                                      SelectionChanged="BackendComboBox_SelectionChanged"
                                      AutomationProperties.LabeledBy="{Binding ElementName=LblBackend}"
                                      AutomationProperties.Name="Connection method"
                                      Margin="0,0,0,8"
                                      TabIndex="10"/>
                        </StackPanel>

                        <!-- Authentication — hidden for Microsoft 365 (Graph), which is always OAuth. -->
                        <StackPanel Visibility="{Binding IsImapBackend, Converter={StaticResource BoolToVisibility}}">
                            <Label x:Name="LblAuthType" Content="_Authentication:" Target="{Binding ElementName=AuthTypeCombo}" Padding="0" Margin="0,0,0,2"/>
                            <ComboBox x:Name="AuthTypeCombo"
                                      SelectedIndex="{Binding AuthTypeIndex, Mode=TwoWay}"
                                      AutomationProperties.LabeledBy="{Binding ElementName=LblAuthType}"
                                      AutomationProperties.Name="Authentication"
                                      TabIndex="11">
                                <ComboBoxItem>Password</ComboBoxItem>
                                <ComboBoxItem>Microsoft OAuth2 (Outlook.com)</ComboBoxItem>
                                <ComboBoxItem Visibility="{Binding ShowGoogleAuthOption, Converter={StaticResource BoolToVisibility}}">Google OAuth (Gmail)</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <!-- IMAP + SMTP — collapsed for Microsoft Graph accounts, which authenticate
                             via OAuth and need no host configuration. -->
                        <StackPanel Visibility="{Binding IsImapBackend, Converter={StaticResource BoolToVisibility}}">
                            <Separator Margin="0,12"/>

                            <TextBlock Text="Incoming Mail (IMAP)" FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <Label x:Name="LblImapHost" Content="IMAP _host:" Target="{Binding ElementName=ImapHostBox}" Padding="0" Margin="0,4,0,2"/>
                            <TextBox x:Name="ImapHostBox"
                                     Text="{Binding ImapHost, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=LblImapHost}"
                                     TabIndex="12"/>

                            <Label x:Name="LblImapPort" Content="IMAP _port:" Target="{Binding ElementName=ImapPortBox}" Padding="0" Margin="0,6,0,2"/>
                            <TextBox x:Name="ImapPortBox"
                                     Text="{Binding ImapPort, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=LblImapPort}"
                                     TabIndex="13"/>

                            <CheckBox Content="Use _SSL (port 993)"
                                      IsChecked="{Binding ImapUseSsl}"
                                      AutomationProperties.Name="IMAP use SSL"
                                      Margin="0,6" TabIndex="14"/>

                            <CheckBox Content="Accept _invalid certificates"
                                      IsChecked="{Binding ImapAcceptInvalidCert}"
                                      AutomationProperties.Name="IMAP accept invalid SSL certificates"
                                      Margin="0,0,0,6" TabIndex="15"/>

                            <Separator Margin="0,6"/>

                            <TextBlock Text="Outgoing Mail (SMTP)" FontWeight="SemiBold" Margin="0,0,0,6"/>

                            <Label x:Name="LblSmtpHost" Content="SMTP h_ost:" Target="{Binding ElementName=SmtpHostBox}" Padding="0" Margin="0,4,0,2"/>
                            <TextBox x:Name="SmtpHostBox"
                                     Text="{Binding SmtpHost, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=LblSmtpHost}"
                                     TabIndex="16"/>

                            <Label x:Name="LblSmtpPort" Content="SMTP po_rt:" Target="{Binding ElementName=SmtpPortBox}" Padding="0" Margin="0,6,0,2"/>
                            <TextBox x:Name="SmtpPortBox"
                                     Text="{Binding SmtpPort, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=LblSmtpPort}"
                                     TabIndex="17"/>

                            <CheckBox Content="Implicit SSL on connect (port _465; uncheck for STARTTLS on port 587)"
                                      IsChecked="{Binding SmtpUseSsl}"
                                      AutomationProperties.Name="SMTP implicit SSL on connect"
                                      Margin="0,6" TabIndex="18"/>

                            <CheckBox Content="Accept invalid certi_ficates"
                                      IsChecked="{Binding SmtpAcceptInvalidCert}"
                                      AutomationProperties.Name="SMTP accept invalid SSL certificates"
                                      Margin="0,0,0,6" TabIndex="19"/>
                        </StackPanel>

                        <Separator Margin="0,6"/>

                        <TextBlock Text="Email Signature" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Label x:Name="LblSignature" Content="Si_gnature (plain text, appended to new messages):" Target="{Binding ElementName=SignatureBox}" Padding="0" Margin="0,4,0,2"/>
                        <TextBox x:Name="SignatureBox"
                                 Text="{Binding Signature, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.LabeledBy="{Binding ElementName=LblSignature}"
                                 AutomationProperties.HelpText="This text is automatically added to the end of new messages, replies, and forwards"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="60"
                                 VerticalScrollBarVisibility="Auto"
                                 TabIndex="20"/>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- Status text -->
        <TextBlock Grid.Row="1"
                   Text="{Binding StatusText}"
                   AutomationProperties.Name="Status"
                   Foreground="{DynamicResource Theme.Accent}"
                   Margin="0,8,0,4"
                   TextWrapping="Wrap"/>

        <!-- Buttons -->
        <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Right"
                    Content="_Cancel"
                    IsCancel="True"
                    Click="CancelButton_Click"
                    AutomationProperties.Name="Cancel"
                    MinWidth="80" Margin="6,0,0,0"/>
            <Button x:Name="TestConnectionButton"
                    DockPanel.Dock="Right"
                    Content="_Test Connection"
                    Command="{Binding TestConnectionCommand}"
                    AutomationProperties.Name="Test connection"
                    MinWidth="120" Margin="6,0,0,0"/>
            <Button DockPanel.Dock="Right"
                    Content="_Add Account"
                    IsDefault="True"
                    Click="AddButton_Click"
                    AutomationProperties.Name="Add account"
                    MinWidth="100"/>
            <TextBlock/>
        </DockPanel>
    </Grid>
</Window>
