<Window x:Class="QuickMail.Views.ImportSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Import Settings"
        Width="620" Height="560"
        MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}"
        FontSize="{DynamicResource Theme.FontSizeBase}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Read first: where the file came from and what importing does. -->
        <TextBox x:Name="SummaryBox"
                 Grid.Row="0"
                 Text="{Binding Summary, Mode=OneWay}"
                 IsReadOnly="True"
                 IsReadOnlyCaretVisible="True"
                 TextWrapping="Wrap"
                 BorderThickness="0"
                 Background="Transparent"
                 AutomationProperties.Name="Import preview"/>

        <Label Grid.Row="1" Content="_What will be imported:" Target="{Binding ElementName=CategoryList}"
               Padding="0" Margin="0,12,0,4"/>
        <ListBox x:Name="CategoryList"
                 Grid.Row="2"
                 ItemsSource="{Binding CategoryLines}"
                 SelectedIndex="0"
                 AutomationProperties.Name="What will be imported">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding}"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <Label Grid.Row="3" Content="_Accounts:" Target="{Binding ElementName=AccountList}"
               Padding="0" Margin="0,12,0,4"
               Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVisibilityConverter}}"/>
        <ListBox x:Name="AccountList"
                 Grid.Row="4"
                 ItemsSource="{Binding Accounts}"
                 SelectedIndex="0"
                 AutomationProperties.Name="Accounts"
                 Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVisibilityConverter}}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <StackPanel x:Name="ButtonRow"
                    Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="ImportButton"
                    Content="_Import and Restart"
                    MinWidth="140"
                    Click="Import_Click"/>
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    MinWidth="90"
                    Margin="8,0,0,0"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
