<Window x:Class="QuickMail.Views.RowFieldsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:QuickMail.Helpers"
        xmlns:views="clr-namespace:QuickMail.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Message List Fields"
        Width="620" Height="500"
        MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}"
        FontSize="{DynamicResource Theme.FontSizeBase}">

    <DockPanel>
        <!-- Button row -->
        <Border x:Name="ButtonBar" DockPanel.Dock="Bottom" Padding="8,6"
                KeyboardNavigation.TabNavigation="Continue">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="MoveUpButton"
                        Content="Move _Up"
                        Command="{Binding MoveUpCommand}"
                        Width="90" Margin="0,0,6,0"
                        AutomationProperties.Name="Move up"/>
                <Button x:Name="MoveDownButton"
                        Content="Move _Down"
                        Command="{Binding MoveDownCommand}"
                        Width="90" Margin="0,0,6,0"
                        AutomationProperties.Name="Move down"/>
                <Button x:Name="ResetButton"
                        Content="_Reset to Defaults"
                        Command="{Binding ResetDefaultsCommand}"
                        Width="130" Margin="0,0,6,0"
                        AutomationProperties.Name="Reset to defaults"/>
                <Button x:Name="CloseButton"
                        Content="Close"
                        Width="80"
                        AutomationProperties.Name="Close"/>
            </StackPanel>
        </Border>

        <!-- Spoken preview -->
        <Border DockPanel.Dock="Bottom" Padding="8,4,8,0">
            <StackPanel>
                <TextBlock Text="Spoken preview" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBox x:Name="PreviewBox"
                         Text="{Binding Preview, Mode=OneWay}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         MinHeight="44"
                         VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Spoken preview"/>
            </StackPanel>
        </Border>

        <!-- Row type -->
        <Border DockPanel.Dock="Top" Padding="8,8,8,4">
            <StackPanel>
                <!-- Label, not TextBlock: Target both carries the access key to the control and
                     associates the two so the control reports this as its name. -->
                <Label Content="_Row type" Target="{Binding ElementName=RowTypeList}"
                       Padding="0" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <ComboBox x:Name="RowTypeList"
                          ItemsSource="{Binding RowKinds}"
                          SelectedItem="{Binding SelectedRowKind, Mode=TwoWay}"
                          AutomationProperties.Name="Row type"/>
            </StackPanel>
        </Border>

        <!-- Fields + options -->
        <Grid Margin="8,4,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="240" MinWidth="180"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Label x:Name="FieldsLabel"
                   Grid.Row="0" Grid.Column="0"
                   Content="_Fields, in spoken order"
                   Target="{Binding ElementName=FieldList}"
                   Padding="0" FontWeight="SemiBold" Margin="0,0,0,2"/>

            <!-- Each row IS a check box, and is ONLY a check box — see FieldCheckList for why a
                 stock ListBox/ItemsControl cannot be used here (both add a wrapper element that
                 repeats the row's name). Arrow keys move between the check boxes via directional
                 navigation, and the whole group is a single tab stop — the list itself is not a
                 tab stop (FieldCheckList overrides the default), so Tab lands on a row rather
                 than on the container first (#464).

                 DirectionalNavigation is Contained, not Cycle: this is a list, and a list's first
                 and last items are its ends — arrowing past them must stop, the way it does in any
                 list box (#459). Cycle belongs to radio groups, where wrapping is the platform
                 behaviour. Contained also keeps arrows inside the group, so focus is not thrown
                 out of the list at either end. -->
            <ScrollViewer Grid.Row="1" Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource Theme.BorderSubtle}"
                          Focusable="False">
                <views:FieldCheckList x:Name="FieldList"
                                      ItemsSource="{Binding Fields}"
                                      Margin="4"
                                      KeyboardNavigation.TabNavigation="Once"
                                      KeyboardNavigation.DirectionalNavigation="Contained"
                                      AutomationProperties.Name="Fields">
                    <views:FieldCheckList.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                      Content="{Binding DisplayName}"
                                      GotKeyboardFocus="FieldCheckBox_GotKeyboardFocus"
                                      Margin="2"
                                      VerticalAlignment="Center"/>
                        </DataTemplate>
                    </views:FieldCheckList.ItemTemplate>
                </views:FieldCheckList>
            </ScrollViewer>

            <GridSplitter Grid.Row="1" Grid.Column="1" Width="4"
                          HorizontalAlignment="Stretch" IsTabStop="False"/>

            <!-- Options for the selected field, plus the global labels switch -->
            <ScrollViewer x:Name="OptionsPanel"
                          Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Field options" FontWeight="SemiBold" Margin="0,0,0,4"/>

                    <!-- Shown only for state fields (unread, attachments, replied…) -->
                    <StackPanel x:Name="SpeakModeGroup"
                                KeyboardNavigation.TabNavigation="Once"
                                KeyboardNavigation.DirectionalNavigation="Cycle"
                                helpers:RadioGroupNavigation.SelectionFollowsFocus="True"
                                AutomationProperties.Name="When to speak">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedIsState}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <RadioButton Content="Speak only when true"
                                     GroupName="SpeakMode"
                                     IsChecked="{Binding SpeakWhenTrue, Mode=TwoWay}"
                                     Margin="0,0,0,2"
                                     AutomationProperties.Name="Speak only when true"/>
                        <RadioButton Content="Always speak"
                                     GroupName="SpeakMode"
                                     IsChecked="{Binding SpeakAlways, Mode=TwoWay}"
                                     AutomationProperties.Name="Always speak"/>
                    </StackPanel>

                    <TextBlock Text="This field is always spoken when it is turned on."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.TextSecondary}"
                               FontSize="{DynamicResource Theme.FontSizeSmall}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedIsState}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Overlap guidance, e.g. Status (combined) vs the separate Unread field.
                         Focusable so it is reachable in the options pane rather than being
                         visual-only text a keyboard user never lands on. -->
                    <TextBox x:Name="FieldNoteBox"
                             Text="{Binding SelectedFieldNote, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             BorderThickness="0"
                             Background="Transparent"
                             Margin="0,8,0,0"
                             FontSize="{DynamicResource Theme.FontSizeSmall}"
                             AutomationProperties.Name="About this field">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedFieldNote}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Separator Margin="0,12,0,8"/>

                    <CheckBox Content="Speak field _labels"
                              IsChecked="{Binding ShowFieldLabels, Mode=TwoWay}"
                              AutomationProperties.Name="Speak field labels"/>
                    <TextBlock Text="Applies to all row types. States and counts are never labelled — they already say what they are."
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource Theme.TextSecondary}"
                               FontSize="{DynamicResource Theme.FontSizeSmall}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
