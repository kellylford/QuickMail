<Window x:Class="QuickMail.Views.ComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:QuickMail.Controls"
        xmlns:sc="clr-namespace:QuickMail.Helpers"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        AutomationProperties.Name="{Binding WindowTitle}"
        Height="540" Width="680"
        MinHeight="360" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}"
        FontSize="{DynamicResource Theme.FontSizeBase}">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Alt"  Command="{Binding SendCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveDraftCommand}"/>
        <KeyBinding Key="A" Modifiers="Ctrl+Shift" Command="{Binding AddAttachmentsCommand}"/>
    </Window.InputBindings>

    <DockPanel>

        <!-- Menu bar. Reached with Alt or F10 (not a tab stop, per platform convention).
             Every item dispatches to the same handler or command as its keyboard
             shortcut. sc:CommandShortcut.Id names that command, and the shown and spoken
             shortcut come from the registry (#849); never write InputGestureText by hand
             for a registered command. -->
        <Menu DockPanel.Dock="Top"
              IsTabStop="False"
              KeyboardNavigation.TabNavigation="None">
            <MenuItem Header="_File">
                <MenuItem Header="_Send" sc:CommandShortcut.Id="compose.send" Click="MenuSend_Click"/>
                <MenuItem Header="Save _Draft" Command="{Binding SaveDraftCommand}" sc:CommandShortcut.Id="compose.saveDraft"/>
                <Separator/>
                <MenuItem sc:CommandShortcut.Id="compose.insertTemplate" Header="_Insert Template…" Command="{Binding InsertTemplateCommand}"/>
                <MenuItem sc:CommandShortcut.Id="compose.saveAsTemplate" Header="Save as _Template" Command="{Binding SaveAsTemplateCommand}"/>
                <Separator/>
                <MenuItem Header="_Add Attachments…" Command="{Binding AddAttachmentsCommand}" sc:CommandShortcut.Id="compose.addAttachments"/>
                <Separator/>
                <MenuItem Header="_Close" Command="{Binding CancelCommand}" sc:CommandShortcut.Id="compose.cancel"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="ApplicationCommands.Undo" AutomationProperties.AcceleratorKey="Ctrl+Z"/>
                <MenuItem Header="_Redo" Command="ApplicationCommands.Redo" AutomationProperties.AcceleratorKey="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="Cu_t" Command="ApplicationCommands.Cut" AutomationProperties.AcceleratorKey="Ctrl+X"/>
                <MenuItem Header="_Copy" Command="ApplicationCommands.Copy" AutomationProperties.AcceleratorKey="Ctrl+C"/>
                <MenuItem Header="_Paste" Command="ApplicationCommands.Paste" AutomationProperties.AcceleratorKey="Ctrl+V"/>
                <MenuItem Header="Select _All" Command="ApplicationCommands.SelectAll" AutomationProperties.AcceleratorKey="Ctrl+A"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Plain Text" x:Name="MenuModePlain"
                          sc:CommandShortcut.Id="compose.setModePlain" Click="MenuModePlain_Click"/>
                <MenuItem Header="_Markdown" x:Name="MenuModeMarkdown"
                          sc:CommandShortcut.Id="compose.setModeMarkdown" Click="MenuModeMarkdown_Click"/>
                <MenuItem Header="_HTML" x:Name="MenuModeHtml"
                          sc:CommandShortcut.Id="compose.setModeHtml" Click="MenuModeHtml_Click"/>
                <Separator/>
                <MenuItem Header="Pre_view" IsEnabled="{Binding IsPreviewAvailable}" sc:CommandShortcut.Id="compose.openPreview" Click="MenuOpenPreview_Click" AutomationProperties.Name="Open preview"/>
            </MenuItem>
            <!-- The top-level Format menu is always enabled (Windows standard:
                 top-level menus are never skipped); individual items gray out
                 in Plain Text mode. Formatting works in HTML (real formatting)
                 and Markdown (inserts the equivalent syntax). -->
            <MenuItem Header="F_ormat" SubmenuOpened="FormatMenu_SubmenuOpened">
                <MenuItem Header="_Bold" sc:CommandShortcut.Id="compose.toggleBold"
                          IsEnabled="{Binding IsFormattingAvailable}" Click="ToolbarBold_Click"/>
                <MenuItem Header="_Italic" sc:CommandShortcut.Id="compose.toggleItalic"
                          IsEnabled="{Binding IsFormattingAvailable}" Click="ToolbarItalic_Click"/>
                <MenuItem Header="_Underline" sc:CommandShortcut.Id="compose.toggleUnderline"
                          IsEnabled="{Binding IsFormattingAvailable}" Click="ToolbarUnderline_Click"/>
                <MenuItem Header="_Strikethrough" sc:CommandShortcut.Id="compose.toggleStrikethrough"
                          IsEnabled="{Binding IsFormattingAvailable}" Click="ToolbarStrikethrough_Click"/>
                <Separator/>
                <!-- The same eight styles as the toolbar's Paragraph style box. Check
                     marks show the style at the caret (set when the submenu opens). -->
                <MenuItem Header="_Paragraph Style" x:Name="ParagraphStyleMenu"
                          IsEnabled="{Binding IsFormattingAvailable}"
                          SubmenuOpened="ParagraphStyleMenu_SubmenuOpened">
                    <MenuItem Header="_Normal Text" sc:CommandShortcut.Id="compose.normalText" Tag="0" Click="MenuParagraphStyle_Click"/>
                    <MenuItem Header="Heading _1" sc:CommandShortcut.Id="compose.heading1" Tag="1" Click="MenuParagraphStyle_Click"/>
                    <MenuItem Header="Heading _2" sc:CommandShortcut.Id="compose.heading2" Tag="2" Click="MenuParagraphStyle_Click"/>
                    <MenuItem Header="Heading _3" sc:CommandShortcut.Id="compose.heading3" Tag="3" Click="MenuParagraphStyle_Click"/>
                    <MenuItem Header="Heading _4" sc:CommandShortcut.Id="compose.heading4" Tag="4" Click="MenuParagraphStyle_Click"/>
                    <MenuItem Header="Heading _5" sc:CommandShortcut.Id="compose.heading5" Tag="5" Click="MenuParagraphStyle_Click"/>
                    <MenuItem Header="Heading _6" sc:CommandShortcut.Id="compose.heading6" Tag="6" Click="MenuParagraphStyle_Click"/>
                    <MenuItem Header="_Quote" sc:CommandShortcut.Id="compose.quote" Tag="7" Click="MenuParagraphStyle_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Bu_llet List" sc:CommandShortcut.Id="compose.bulletList"
                          IsEnabled="{Binding IsFormattingAvailable}" Click="ToolbarBulletList_Click"/>
                <MenuItem Header="_Numbered List" sc:CommandShortcut.Id="compose.numberedList"
                          IsEnabled="{Binding IsFormattingAvailable}" Click="ToolbarNumberedList_Click"/>
                <Separator/>
                <MenuItem Header="_Clear Formatting" sc:CommandShortcut.Id="compose.clearFormatting"
                          IsEnabled="{Binding IsFormattingAvailable}" Click="ToolbarClearFormatting_Click"/>
                <MenuItem Header="_Announce Formatting" sc:CommandShortcut.Id="compose.queryFormatting"
                          IsEnabled="{Binding IsFormattingAvailable}" Click="MenuAnnounceFormatting_Click"/>
                <MenuItem Header="Sho_w Formatting…" sc:CommandShortcut.Id="compose.showFormatting"
                          IsEnabled="{Binding IsFormattingAvailable}" Click="MenuShowFormatting_Click"/>
            </MenuItem>
            <!-- Insert (#729). Link is Ctrl+K from the message body, as in Outlook; Ctrl+L
                 also works. Image works in every mode: in Plain Text it offers to attach the
                 picture instead, so it is never grayed. -->
            <MenuItem Header="_Insert">
                <MenuItem Header="_Link…" sc:CommandShortcut.Id="compose.insertLinkFromBody"
                          IsEnabled="{Binding IsFormattingAvailable}" Click="ToolbarInsertLink_Click"/>
                <MenuItem Header="_Image…" sc:CommandShortcut.Id="compose.insertImage" Click="MenuInsertImage_Click"/>
                <MenuItem Header="Image _Properties…" sc:CommandShortcut.Id="compose.imageProperties"
                          IsEnabled="{Binding IsFormattingAvailable}" Click="MenuImageProperties_Click"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Check _Spelling…" sc:CommandShortcut.Id="compose.checkSpelling"
                          IsEnabled="{Binding IsSpellNavAvailable}"
                          Click="MenuCheckSpelling_Click"/>
                <MenuItem Header="_Next Misspelling" sc:CommandShortcut.Id="compose.nextMisspelling"
                          IsEnabled="{Binding IsSpellNavAvailable}"
                          Click="MenuNextMisspelling_Click"/>
                <MenuItem Header="Pre_vious Misspelling" sc:CommandShortcut.Id="compose.prevMisspelling"
                          IsEnabled="{Binding IsSpellNavAvailable}"
                          Click="MenuPrevMisspelling_Click"/>
                <MenuItem sc:CommandShortcut.Id="compose.toggleSpellingAnnouncements" Header="_Toggle Spelling Announcements" Click="MenuToggleSpelling_Click"/>
                <Separator/>
                <MenuItem Header="_Address Book…" sc:CommandShortcut.Id="compose.openAddressBook" Click="MenuAddressBook_Click"/>
                <MenuItem Header="Chec_k Addresses" sc:CommandShortcut.Id="compose.checkAddresses" Click="MenuCheckAddresses_Click"/>
                <Separator/>
                <MenuItem Header="Command _Palette…" InputGestureText="Ctrl+Shift+P" AutomationProperties.AcceleratorKey="Ctrl+Shift+P" Click="MenuCommandPalette_Click"/>
            </MenuItem>
        </Menu>

    <DockPanel Margin="10"
               AllowDrop="True"
               DragOver="Window_DragOver"
               Drop="Window_Drop">

        <!-- Formatting toolbar — visible in HTML mode only (managed in code-behind) -->
        <ToolBarTray DockPanel.Dock="Top" x:Name="FormattingToolbarTray" Visibility="Collapsed"
                     Background="{DynamicResource Theme.ChromeBackground}">
            <ToolBar KeyboardNavigation.TabNavigation="Once"
                     KeyboardNavigation.DirectionalNavigation="Cycle"
                     Background="{DynamicResource Theme.ChromeBackground}"
                     Foreground="{DynamicResource Theme.TextPrimary}">
                <Button x:Name="BoldButton" Content="B" FontWeight="Bold" MinWidth="28"
                        AutomationProperties.Name="Bold"
                        sc:CommandShortcut.Id="compose.toggleBold"
                        sc:CommandShortcut.ToolTip="Bold" Click="ToolbarBold_Click"/>
                <Button Content="I" FontStyle="Italic" MinWidth="28"
                        AutomationProperties.Name="Italic"
                        sc:CommandShortcut.Id="compose.toggleItalic"
                        sc:CommandShortcut.ToolTip="Italic" Click="ToolbarItalic_Click"/>
                <Button MinWidth="28"
                        AutomationProperties.Name="Underline"
                        sc:CommandShortcut.Id="compose.toggleUnderline"
                        sc:CommandShortcut.ToolTip="Underline" Click="ToolbarUnderline_Click">
                    <TextBlock Text="U" TextDecorations="Underline"/>
                </Button>
                <Button MinWidth="28"
                        AutomationProperties.Name="Strikethrough"
                        sc:CommandShortcut.Id="compose.toggleStrikethrough"
                        sc:CommandShortcut.ToolTip="Strikethrough" Click="ToolbarStrikethrough_Click">
                    <TextBlock Text="S" TextDecorations="Strikethrough"/>
                </Button>
                <Separator/>
                <!-- Shows the style at the caret and applies a choice to the selected
                     paragraphs. Item order is ComposeParagraphStyle's values. -->
                <ComboBox x:Name="ParagraphStyleCombo" MinWidth="120"
                          AutomationProperties.Name="Paragraph style"
                          ToolTip="Paragraph style (Ctrl+Alt+0 to 6, Ctrl+Shift+9)"
                          PreviewKeyDown="ParagraphStyleCombo_PreviewKeyDown"
                          DropDownClosed="ParagraphStyleCombo_DropDownClosed"
                          IsKeyboardFocusWithinChanged="ParagraphStyleCombo_IsKeyboardFocusWithinChanged">
                    <ComboBoxItem Content="Normal text"/>
                    <ComboBoxItem Content="Heading 1"/>
                    <ComboBoxItem Content="Heading 2"/>
                    <ComboBoxItem Content="Heading 3"/>
                    <ComboBoxItem Content="Heading 4"/>
                    <ComboBoxItem Content="Heading 5"/>
                    <ComboBoxItem Content="Heading 6"/>
                    <ComboBoxItem Content="Quote"/>
                </ComboBox>
                <Separator/>
                <Button Content="• List" MinWidth="40"
                        AutomationProperties.Name="Bullet list"
                        sc:CommandShortcut.Id="compose.bulletList"
                        sc:CommandShortcut.ToolTip="Bullet List" Click="ToolbarBulletList_Click"/>
                <Button Content="1. List" MinWidth="40"
                        AutomationProperties.Name="Numbered list"
                        sc:CommandShortcut.Id="compose.numberedList"
                        sc:CommandShortcut.ToolTip="Numbered List" Click="ToolbarNumberedList_Click"/>
                <Separator/>
                <Button Content="Link" MinWidth="40"
                        AutomationProperties.Name="Insert link"
                        sc:CommandShortcut.Id="compose.insertLinkFromBody"
                        sc:CommandShortcut.ToolTip="Insert Link" Click="ToolbarInsertLink_Click"/>
                <Button Content="Image" MinWidth="40"
                        AutomationProperties.Name="Insert image"
                        sc:CommandShortcut.Id="compose.insertImage"
                        sc:CommandShortcut.ToolTip="Insert Image" Click="MenuInsertImage_Click"/>
                <Button Content="Clear" MinWidth="40"
                        AutomationProperties.Name="Clear formatting"
                        sc:CommandShortcut.Id="compose.clearFormatting"
                        sc:CommandShortcut.ToolTip="Clear Formatting" Click="ToolbarClearFormatting_Click"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Status / progress bar -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <!-- Order matters: DockPanel hands out space in DECLARATION order, so
                 the mode selector is declared first and takes its MinWidth before
                 the buttons see any. Previously the buttons docked Right first and
                 consumed the whole row, crushing the selector to a sliver at 150%
                 text (#450). The buttons then sit in a WrapPanel — measured against
                 what is left — so they break onto a second line instead of clipping.
                 Declaration order here is visual order (it was reversed when each
                 button docked Right individually) and matches TabIndex. -->
            <ComboBox DockPanel.Dock="Left"
                      x:Name="ModeSelector"
                      MinWidth="110" Margin="0,2,6,0"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="Compose mode"
                      TabIndex="12"
                      SelectionChanged="ModeSelector_SelectionChanged">
                <ComboBoxItem Content="Plain Text"/>
                <ComboBoxItem Content="Markdown"/>
                <ComboBoxItem Content="HTML"/>
            </ComboBox>
            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button x:Name="SendButton"
                        Content="Send"
                        Command="{Binding SendCommand}"
                        AutomationProperties.Name="Send message"
                        sc:CommandShortcut.Id="compose.send"
                        MinWidth="80" Margin="6,2,0,0"
                        TabIndex="7"/>
                <Button Content="Insert Template…"
                        Command="{Binding InsertTemplateCommand}"
                        AutomationProperties.Name="Insert a saved template"
                        MinWidth="120" Margin="6,2,0,0"
                        TabIndex="8"/>
                <Button Content="Save as Template"
                        Command="{Binding SaveAsTemplateCommand}"
                        AutomationProperties.Name="Save current message as template"
                        MinWidth="120" Margin="6,2,0,0"
                        TabIndex="9"/>
                <Button Content="Save Draft"
                        Command="{Binding SaveDraftCommand}"
                        AutomationProperties.Name="Save as draft"
                        sc:CommandShortcut.Id="compose.saveDraft"
                        MinWidth="100" Margin="6,2,0,0"
                        TabIndex="10"/>
                <Button Content="_Cancel"
                        Command="{Binding CancelCommand}"
                        sc:CommandShortcut.Id="compose.cancel"
                        AutomationProperties.Name="Cancel and close compose window"
                        IsCancel="True"
                        MinWidth="80" Margin="6,2,0,0"
                        TabIndex="11"/>
            </WrapPanel>
            <!-- Deliberately NOT IsDefault. A default button makes Enter send the
                 message from any control that does not handle Enter itself — the
                 From combo, the compose-mode combo, the Subject box, the attachment
                 list. Choosing a sending account with arrow-then-Enter would send
                 the half-written message and disclose its contents (issue #201).
                 Send is reachable by Alt+S, Ctrl+Enter, or Enter/Space with the
                 Send button focused. Do not re-add IsDefault. -->
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Text="{Binding AutoSaveText}"
                       Foreground="{DynamicResource Theme.TextSecondary}"
                       Margin="0,0,8,0"/>
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding StatusText}"
                       AutomationProperties.Name="Send status"
                       Foreground="{DynamicResource Theme.Error}"/>
        </DockPanel>

        <!-- Autocomplete popup — positioned below the active address field via
             code-behind. Declared BEFORE the form grid on purpose: a Popup
             occupies no layout space, but as the DockPanel's last child it
             would receive LastChildFill, leaving the form grid to default to
             Dock=Left at content width — which shipped as a shrunken, left-
             docked compose form with two thirds of the window empty (#435). -->
        <Popup x:Name="AutoCompletePopup"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="None">
            <Border BorderBrush="{DynamicResource Theme.Border}"
                    BorderThickness="1"
                    Background="{DynamicResource Theme.WindowBackground}">
                <ListBox x:Name="SuggestionList"
                         MaxHeight="200"
                         MinWidth="300"
                         AutomationProperties.Name="Address suggestions"
                         IsTabStop="True"
                         KeyboardNavigation.TabNavigation="Cycle">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Display}"/>
                            <Setter Property="Padding" Value="6,3"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding PrimaryText}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SecondaryText}"
                                           Opacity="0.75"
                                           FontSize="{DynamicResource Theme.FontSizeSmall}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>

        <!-- Form fields -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- From -->
            <Label Grid.Row="0" Grid.Column="0"
                   x:Name="FromLabel"
                   Content="Fro_m:"
                   Target="{Binding ElementName=FromCombo}"
                   Padding="0" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Grid.Row="0" Grid.Column="1"
                      x:Name="FromCombo"
                      ItemsSource="{Binding SenderAccounts}"
                      SelectedItem="{Binding SenderAccount, Mode=TwoWay}"
                      DisplayMemberPath="AccountLabel"
                      AutomationProperties.Name="From account"
                      AutomationProperties.AcceleratorKey="Alt+M"
                      AutomationProperties.HelpText="Choose which account to send from"
                      Margin="0,4" TabIndex="0"
                      PreviewKeyDown="FromCombo_PreviewKeyDown"/>

            <!-- To -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       x:Name="ToLabel" Text="To:"
                       VerticalAlignment="Center" Margin="0,4"/>
            <controls:TokenizedAddressBox Grid.Row="1" Grid.Column="1"
                     x:Name="ToBox"
                     AddressText="{Binding To, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.LabeledBy="{Binding ElementName=ToLabel}"
                     AutomationProperties.HelpText="Type an address and press comma, semicolon, or Tab to add it. Arrow keys navigate between addresses. Delete removes the focused address."
                     Margin="0,4" TabIndex="1"/>

            <!-- Cc -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       x:Name="CcLabel" Text="Cc:"
                       VerticalAlignment="Center" Margin="0,4"/>
            <controls:TokenizedAddressBox Grid.Row="2" Grid.Column="1"
                     x:Name="CcBox"
                     AddressText="{Binding Cc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.LabeledBy="{Binding ElementName=CcLabel}"
                     Margin="0,4" TabIndex="2"/>

            <!-- Bcc -->
            <TextBlock Grid.Row="3" Grid.Column="0"
                       x:Name="BccLabel" Text="Bcc:"
                       VerticalAlignment="Center" Margin="0,4"/>
            <controls:TokenizedAddressBox Grid.Row="3" Grid.Column="1"
                     x:Name="BccBox"
                     AddressText="{Binding Bcc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.LabeledBy="{Binding ElementName=BccLabel}"
                     Margin="0,4" TabIndex="3"/>

            <!-- Subject -->
            <Label Grid.Row="4" Grid.Column="0"
                   x:Name="SubjectLabel" Content="S_ubject:"
                   Target="{Binding ElementName=SubjectBox}"
                   Padding="0" VerticalAlignment="Center" Margin="0,4"/>
            <TextBox Grid.Row="4" Grid.Column="1"
                     x:Name="SubjectBox"
                     Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.LabeledBy="{Binding ElementName=SubjectLabel}"
                     AutomationProperties.Name="Subject"
                     AutomationProperties.AcceleratorKey="Alt+U"
                     IsInactiveSelectionHighlightEnabled="True"
                     Margin="0,4" TabIndex="4"/>

            <Separator Grid.Row="5" Grid.ColumnSpan="2" Margin="0,4"/>

            <!-- Attachments -->
            <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                    Content="Add Files…"
                    Command="{Binding AddAttachmentsCommand}"
                    AutomationProperties.Name="Add file attachments"
                    sc:CommandShortcut.Id="compose.addAttachments"
                    HorizontalAlignment="Left"
                    Margin="0,2" TabIndex="5"/>
            <ListBox Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                     x:Name="AttachmentList"
                     ItemsSource="{Binding Attachments}"
                     SelectionMode="Single"
                     MaxHeight="80"
                     Margin="0,2"
                     TabIndex="6"
                     KeyboardNavigation.TabNavigation="Once"
                     KeyboardNavigation.DirectionalNavigation="Contained"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Attachments"
                     PreviewKeyDown="AttachmentList_PreviewKeyDown"
                     GotKeyboardFocus="AttachmentList_GotKeyboardFocus">
                <ListBox.Style>
                    <!-- BasedOn the themed ListBox (issue #825): without it this local style
                         replaced the theme's and the list drew stock white, on which the
                         secondary size text has too little contrast in dark themes. -->
                    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Attachments.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Size as visible text, not a tooltip (issue #825). Docked right so a long
                             file name trims with an ellipsis instead of pushing the size off the row. The
                             container's AccessibleName still reads "name, size". -->
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding FileSizeDisplay}"
                                       Style="{StaticResource RowSecondaryText}"
                                       Margin="8,0,4,0"/>
                            <TextBlock Text="{Binding FileName}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="_Open"
                                  Command="{Binding PlacementTarget.DataContext.OpenComposeAttachmentCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="_Remove"
                                  Command="{Binding PlacementTarget.DataContext.RemoveAttachmentCommand,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <!-- Attachment summary: file count and total size -->
            <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="{Binding AttachmentSummaryText}"
                       FontSize="{DynamicResource Theme.FontSizeSmall}"
                       Foreground="{DynamicResource Theme.TextSecondary}"
                       VerticalAlignment="Bottom"
                       Margin="2,0,0,2">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Attachments.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Body: plain/Markdown TextBox and rich HTML editor.
                 Only one editor is visible at a time; visibility is swapped in
                 code-behind when the compose mode changes. -->
            <Grid Grid.Row="9" Grid.ColumnSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0"
                         x:Name="BodyBox"
                         Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Message body"
                         sc:CommandShortcut.Id="compose.focusBody"
                         AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="Wrap"
                         IsInactiveSelectionHighlightEnabled="True"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="{DynamicResource Theme.FontFamily}"
                         Margin="0,4" TabIndex="7"
                         VerticalAlignment="Stretch"
                         PreviewDragOver="Editor_PreviewDragOver"
                         PreviewDrop="Editor_PreviewDrop"
                         PreviewKeyDown="BodyBox_PreviewKeyDown"/>

                <RichTextBox Grid.Row="0"
                             x:Name="RichBodyBox"
                             Visibility="Collapsed"
                             AutomationProperties.Name="Message body"
                             sc:CommandShortcut.Id="compose.focusBody"
                             AcceptsReturn="True" AcceptsTab="True"
                             IsInactiveSelectionHighlightEnabled="True"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="{DynamicResource Theme.FontFamily}"
                             Margin="0,4" TabIndex="7"
                             VerticalAlignment="Stretch"
                             PreviewDragOver="Editor_PreviewDragOver"
                             PreviewDrop="Editor_PreviewDrop"
                             TextChanged="RichBodyBox_TextChanged"/>
            </Grid>
        </Grid>
    </DockPanel>
    </DockPanel>
</Window>
