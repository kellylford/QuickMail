<Window x:Class="QuickMail.Views.SoundSchemeNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="190" Width="380"
        MinHeight="170" MinWidth="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}"
        FontSize="{DynamicResource Theme.FontSizeBase}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- Modeless (#932): an editable text box in a nested modal loop over a window hosting WebView2 can
         freeze the UI with a screen reader running (CLAUDE.md, Modal Dialog Rules). So Enter and Escape
         are wired by hand, not through IsDefault/IsCancel and DialogResult. -->
    <DockPanel Margin="12">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OkButton" Content="OK" MinWidth="75" Margin="0,0,6,0"
                    Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="75"
                    Click="CancelButton_Click"/>
        </StackPanel>

        <StackPanel>
            <Label Content="_Name:" Target="{Binding ElementName=NameBox}" Padding="0,0,0,2"/>
            <TextBox x:Name="NameBox" AutomationProperties.Name="Name" MaxLength="60"/>
            <TextBlock x:Name="ProblemText" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
        </StackPanel>

    </DockPanel>
</Window>
