<Window x:Class="QuickMail.Views.SoundGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sound Scheme Gallery"
        Height="420" Width="520"
        MinHeight="300" MinWidth="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}"
        FontSize="{DynamicResource Theme.FontSizeBase}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <!-- No editable text, so a modal dialog over Settings is safe (CLAUDE.md, Modal Dialog Rules). -->
    <DockPanel Margin="12">

        <StackPanel x:Name="ButtonPanel" DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <!-- Add, or Update when the gallery has a newer version of a scheme already added; turned
                 off for one already added. -->
            <Button x:Name="AddButton" Content="{Binding AddLabel}" MinWidth="85" Margin="0,0,6,0" TabIndex="2"
                    AutomationProperties.Name="{Binding AddName}"
                    IsEnabled="{Binding CanAdd}" Click="AddButton_Click"/>
            <Button x:Name="ReloadButton" Content="_Reload" MinWidth="85" Margin="0,0,6,0" TabIndex="3"
                    AutomationProperties.Name="Reload" Click="ReloadButton_Click"/>
            <Button x:Name="CloseButton" Content="Close" MinWidth="85" TabIndex="4"
                    AutomationProperties.Name="Close" Click="CloseButton_Click"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,6"/>

        <!-- The selected scheme's description, author and licence, as a read-only text box a screen
             reader's cursor can read through, like the app's other detail areas (the Properties window,
             the import preview). Read-only, as those are: the deadlock in CLAUDE.md's Modal Dialog Rules
             came from an editable box in a nested modal loop. -->
        <TextBox x:Name="DetailsBox" DockPanel.Dock="Bottom" Margin="0,8,0,0" TabIndex="1"
                 Text="{Binding Details, Mode=OneWay}"
                 IsReadOnly="True" IsReadOnlyCaretVisible="True"
                 TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                 AutomationProperties.Name="Details"
                 Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}"/>

        <DockPanel>
            <Label DockPanel.Dock="Top" Content="_Sound schemes:" Target="{Binding ElementName=SchemeList}" Padding="0,0,0,2"/>
            <ListBox x:Name="SchemeList" AutomationProperties.Name="Sound schemes" TabIndex="0"
                     ItemsSource="{Binding Entries}"
                     SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                     DisplayMemberPath="AccessibleName"
                     IsTextSearchEnabled="True" TextSearch.TextPath="Name">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <!-- The row's name on the container (CLAUDE.md); the description as its help text. -->
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                        <Setter Property="AutomationProperties.HelpText" Value="{Binding HelpText}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>

    </DockPanel>
</Window>
