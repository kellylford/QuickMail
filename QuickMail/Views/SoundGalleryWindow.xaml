<Window x:Class="QuickMail.Views.SoundGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sound Scheme Gallery"
        Height="420" Width="520"
        MinHeight="300" MinWidth="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}"
        FontSize="{DynamicResource Theme.FontSizeBase}">

    <!-- No editable text, so a modal dialog over Settings is safe (CLAUDE.md, Modal Dialog Rules). -->
    <DockPanel Margin="12">

        <StackPanel x:Name="ButtonPanel" DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="AddButton" Content="_Add" MinWidth="85" Margin="0,0,6,0"
                    AutomationProperties.Name="Add"
                    IsEnabled="{Binding CanAdd}" Click="AddButton_Click"/>
            <Button x:Name="RetryButton" Content="_Try again" MinWidth="85" Margin="0,0,6,0"
                    AutomationProperties.Name="Try again" Click="RetryButton_Click"/>
            <Button x:Name="CloseButton" Content="Close" MinWidth="85"
                    AutomationProperties.Name="Close" Click="CloseButton_Click"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,6"/>

        <TextBlock x:Name="DetailsText" DockPanel.Dock="Bottom" Text="{Binding Details}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Foreground="{DynamicResource Theme.TextSecondary}"/>

        <DockPanel>
            <Label DockPanel.Dock="Top" Content="_Sound schemes:" Target="{Binding ElementName=SchemeList}" Padding="0,0,0,2"/>
            <ListBox x:Name="SchemeList" AutomationProperties.Name="Sound schemes"
                     ItemsSource="{Binding Entries}"
                     SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                     DisplayMemberPath="AccessibleName"
                     IsTextSearchEnabled="True" TextSearch.TextPath="Name">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <!-- The row's name on the container (CLAUDE.md); the description as its help text. -->
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                        <Setter Property="AutomationProperties.HelpText" Value="{Binding Description}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>

    </DockPanel>
</Window>
