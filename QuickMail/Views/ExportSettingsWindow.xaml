<Window x:Class="QuickMail.Views.ExportSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Export Settings"
        Width="520" Height="520"
        MinWidth="400" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}"
        FontSize="{DynamicResource Theme.FontSizeBase}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="What to export:" Margin="0,0,0,8"/>

        <!-- One tab stop for the group; arrows move between the checkboxes, as in Add to Address Book. -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      IsTabStop="False"
                      AutomationProperties.Name="What to export">
            <ItemsControl x:Name="CategoryList"
                          ItemsSource="{Binding Categories}"
                          KeyboardNavigation.TabNavigation="Once"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          IsTabStop="False"
                          Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked}"
                                  Content="{Binding Name}"
                                  AutomationProperties.Name="{Binding Name}"
                                  Margin="0,4"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBox x:Name="SummaryBox"
                 Grid.Row="2"
                 Text="{Binding Summary, Mode=OneWay}"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 BorderThickness="0"
                 Background="Transparent"
                 Margin="0,10,0,0"
                 AutomationProperties.Name="Summary"/>

        <StackPanel x:Name="ButtonRow"
                    Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="ExportButton"
                    Content="_Export…"
                    IsDefault="True"
                    IsEnabled="{Binding CanExportNow}"
                    MinWidth="90"
                    Click="Export_Click"/>
            <Button Content="Cancel"
                    MinWidth="90"
                    Margin="8,0,0,0"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
