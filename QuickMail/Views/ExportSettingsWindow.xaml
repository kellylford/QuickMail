<Window x:Class="QuickMail.Views.ExportSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:views="clr-namespace:QuickMail.Views"
        mc:Ignorable="d"
        Title="Export Settings"
        Width="520" Height="520"
        MinWidth="400" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}"
        FontSize="{DynamicResource Theme.FontSizeBase}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="What _to export:" Target="{Binding ElementName=CategoryList}"
               Padding="0" Margin="0,0,0,8"/>

        <!-- FieldCheckList, as in Message List Fields: each row is one check box in a list, so its
             name is spoken once (a plain ItemsControl added a same-named row around each check box),
             it has position and count, and Home/End reach the first and last row. One tab stop;
             arrows move between rows. -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      IsTabStop="False"
                      Focusable="False">
            <views:FieldCheckList x:Name="CategoryList"
                                  ItemsSource="{Binding Categories}"
                                  KeyboardNavigation.TabNavigation="Once"
                                  KeyboardNavigation.DirectionalNavigation="Contained"
                                  AutomationProperties.Name="What to export">
                <views:FieldCheckList.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  Content="{Binding Name}"
                                  Margin="0,4"/>
                    </DataTemplate>
                </views:FieldCheckList.ItemTemplate>
            </views:FieldCheckList>
        </ScrollViewer>

        <TextBox x:Name="SummaryBox"
                 Grid.Row="2"
                 Text="{Binding Summary, Mode=OneWay}"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 BorderThickness="0"
                 Background="Transparent"
                 Margin="0,10,0,0"
                 AutomationProperties.Name="Summary"/>

        <StackPanel x:Name="ButtonRow"
                    Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button x:Name="ExportButton"
                    Content="_Export…"
                    IsDefault="True"
                    IsEnabled="{Binding CanExportNow}"
                    MinWidth="90"
                    Click="Export_Click"/>
            <Button Content="Cancel"
                    MinWidth="90"
                    Margin="8,0,0,0"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
