<Window x:Class="QuickMail.Views.ConnectionDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Connection Diagnostics"
        Width="900" Height="620"
        MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}"
        FontSize="{DynamicResource Theme.FontSizeBase}">

    <DockPanel>

        <!-- Button row -->
        <Border DockPanel.Dock="Bottom" Padding="8,6">
            <StackPanel x:Name="ButtonRow" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="TestButton"
                        Content="_Test this account"
                        Command="{Binding TestAccountCommand}"
                        MinWidth="130" Margin="0,0,6,0"
                        AutomationProperties.Name="Test this account"/>
                <Button x:Name="CopyButton"
                        Content="_Copy report"
                        Command="{Binding CopyReportCommand}"
                        MinWidth="100" Margin="0,0,6,0"
                        AutomationProperties.Name="Copy report"/>
                <Button x:Name="SaveButton"
                        Content="_Save report…"
                        Command="{Binding SaveReportCommand}"
                        MinWidth="110" Margin="0,0,6,0"
                        AutomationProperties.Name="Save report"/>
                <Button x:Name="RefreshButton"
                        Content="_Refresh"
                        Command="{Binding RefreshNowCommand}"
                        MinWidth="80" Margin="0,0,6,0"
                        AutomationProperties.Name="Refresh"/>
                <Button x:Name="CloseButton"
                        Content="Close"
                        MinWidth="80"
                        AutomationProperties.Name="Close"/>
            </StackPanel>
        </Border>

        <Grid Margin="8,8,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Accounts"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>

            <!-- Accounts: what the app shows vs. what the server actually said -->
            <ListBox x:Name="AccountList"
                     Grid.Row="1"
                     Height="150"
                     ItemsSource="{Binding Accounts}"
                     SelectedItem="{Binding SelectedAccount}"
                     HorizontalContentAlignment="Stretch"
                     AutomationProperties.Name="Accounts">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                <TextBlock Text=" — "/>
                                <TextBlock Text="{Binding StatusText}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding VerdictText}"
                                       Foreground="{DynamicResource Theme.TextSecondary}"
                                       FontSize="{DynamicResource Theme.FontSizeSmall}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Journal filter -->
            <DockPanel Grid.Row="2" Margin="0,10,0,4">
                <TextBlock Text="Connection events"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="FilterCombo"
                          DockPanel.Dock="Right"
                          Width="200"
                          HorizontalAlignment="Right"
                          ItemsSource="{Binding FilterOptions}"
                          SelectedItem="{Binding EventFilter}"
                          AutomationProperties.Name="Filter events by account"/>
            </DockPanel>

            <!-- The journal itself. Monospaced so aligned fields stay readable, and each row's
                 accessible name comes from ConnectionEvent.ToString(). -->
            <ListBox x:Name="EventList"
                     Grid.Row="3"
                     ItemsSource="{Binding Events}"
                     FontFamily="Consolas"
                     FontSize="{DynamicResource Theme.FontSizeSmall}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     AutomationProperties.Name="Connection events"/>
        </Grid>
    </DockPanel>
</Window>
