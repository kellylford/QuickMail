<Window x:Class="QuickMail.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vm="clr-namespace:QuickMail.ViewModels"
        xmlns:sc="clr-namespace:QuickMail.Helpers"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        AutomationProperties.Name="{Binding WindowTitle}"
        Height="560" Width="720"
        MinHeight="300" MinWidth="480"
        WindowStartupLocation="Manual"
        d:DataContext="{d:DesignInstance Type=vm:MessageWindowViewModel}"
        Closing="OnClosing"
        PreviewKeyDown="OnPreviewKeyDown"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}"
        FontSize="{DynamicResource Theme.FontSizeBase}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <DockPanel>
        <!-- Menu bar (Alt / F10 to open) -->
        <Menu x:Name="MainMenuBar" DockPanel.Dock="Top" IsMainMenu="True">
            <MenuItem Header="_File">
                <MenuItem Header="_Save"
                          AutomationProperties.Name="Save"
                          Command="{Binding SaveMessageCommand}"
                          sc:CommandShortcut.Id="message.save"/>
                <MenuItem Header="Save _As…"
                          AutomationProperties.Name="Save As"
                          Command="{Binding SaveMessageAsCommand}"
                          sc:CommandShortcut.Id="message.saveAs"/>
                <MenuItem Header="_Print…"
                          AutomationProperties.Name="Print"
                          Command="{Binding PrintMessageCommand}"
                          sc:CommandShortcut.Id="message.print"/>
                <Separator/>
                <MenuItem Header="Close _Window"
                          AutomationProperties.Name="Close Window"
                          Command="{Binding CloseCommand}"
                          sc:CommandShortcut.Id="window.close"/>
            </MenuItem>
            <MenuItem Header="_Message">
                <MenuItem Header="_Reply"
                          AutomationProperties.Name="Reply"
                          Command="{Binding ReplyCommand}"
                          sc:CommandShortcut.Id="message.reply"/>
                <MenuItem Header="Reply _All"
                          AutomationProperties.Name="Reply All"
                          Command="{Binding ReplyAllCommand}"
                          sc:CommandShortcut.Id="message.replyAll"/>
                <MenuItem Header="_Forward"
                          AutomationProperties.Name="Forward"
                          Command="{Binding ForwardCommand}"
                          sc:CommandShortcut.Id="message.forward"/>
                <Separator/>
                <MenuItem Header="_Delete"
                          AutomationProperties.Name="Delete"
                          Command="{Binding DeleteMessageCommand}"
                          sc:CommandShortcut.Id="message.delete"/>
                <MenuItem Header="_Mark as Read"
                          AutomationProperties.Name="Mark as Read"
                          Command="{Binding MarkReadCommand}"
                          sc:CommandShortcut.Id="message.markRead"/>
                <Separator/>
                <MenuItem Header="_Grab Addresses from Message"
                          AutomationProperties.Name="Grab Addresses from Message"
                          Command="{Binding GrabAddressesCommand}"
                          sc:CommandShortcut.Id="message.grabAddresses"/>
                <MenuItem Header="Crea_te Rule from Message…"
                          AutomationProperties.Name="Create Rule from Message"
                          Command="{Binding CreateRuleFromMessageCommand}"
                          sc:CommandShortcut.Id="message.createRule"/>
            </MenuItem>
            <MenuItem Header="_Navigate">
                <MenuItem Header="_Previous Message"
                          AutomationProperties.Name="Previous Message"
                          Command="{Binding PreviousMessageCommand}"
                          sc:CommandShortcut.Id="window.previousMessage"/>
                <MenuItem Header="_Next Message"
                          AutomationProperties.Name="Next Message"
                          Command="{Binding NextMessageCommand}"
                          sc:CommandShortcut.Id="window.nextMessage"/>
                <Separator/>
                <MenuItem Header="Move to _Main Window"
                          AutomationProperties.Name="Move to Main Window"
                          Command="{Binding MoveToMainWindowCommand}"/>
            </MenuItem>
            <!-- The main window's Tools > Rules…, so the Rules Manager is reachable from the message
                 you have just read. -->
            <MenuItem Header="_Tools">
                <MenuItem Header="_Rules…"
                          AutomationProperties.Name="Manage Rules"
                          Command="{Binding ManageRulesCommand}"
                          sc:CommandShortcut.Id="window.manageRules"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar Band="1" BandIndex="1">
                <Button x:Name="PrevButton"
                        Content="◀ Previous"
                        Command="{Binding PreviousMessageCommand}"
                        Padding="6,2"
                        sc:CommandShortcut.Id="window.previousMessage" sc:CommandShortcut.ToolTip="Previous message"
                        AutomationProperties.Name="Previous message"/>
                <Button x:Name="NextButton"
                        Content="Next ▶"
                        Command="{Binding NextMessageCommand}"
                        Padding="6,2"
                        sc:CommandShortcut.Id="window.nextMessage" sc:CommandShortcut.ToolTip="Next message"
                        AutomationProperties.Name="Next message"/>
                <Separator/>
                <Button Content="Reply"
                        Command="{Binding ReplyCommand}"
                        Padding="6,2"
                        sc:CommandShortcut.Id="message.reply" sc:CommandShortcut.ToolTip="Reply"
                        AutomationProperties.Name="Reply"/>
                <Button Content="Reply All"
                        Command="{Binding ReplyAllCommand}"
                        Padding="6,2"
                        sc:CommandShortcut.Id="message.replyAll" sc:CommandShortcut.ToolTip="Reply All"
                        AutomationProperties.Name="Reply All"/>
                <Button Content="Forward"
                        Command="{Binding ForwardCommand}"
                        Padding="6,2"
                        sc:CommandShortcut.Id="message.forward" sc:CommandShortcut.ToolTip="Forward"
                        AutomationProperties.Name="Forward"/>
                <Separator/>
                <Button Content="Delete"
                        Command="{Binding DeleteMessageCommand}"
                        Padding="6,2"
                        sc:CommandShortcut.Id="message.delete" sc:CommandShortcut.ToolTip="Delete"
                        AutomationProperties.Name="Delete"/>
                <Separator/>
                <Button Content="Move to Main Window"
                        Command="{Binding MoveToMainWindowCommand}"
                        Padding="6,2"
                        AutomationProperties.Name="Move this message to the main window as a tab"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom"
                   AutomationProperties.Name="Status">
            <StatusBarItem>
                <TextBlock Text="{Binding PositionText, Mode=OneWay}"
                           AutomationProperties.LiveSetting="Off"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Header fields -->
        <Border DockPanel.Dock="Top"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Theme.Border}"
                Padding="8,6,8,6">
            <StackPanel>
                <TextBox x:Name="SubjectField"
                         Text="{Binding MessageDetail.Subject, FallbackValue='', Mode=OneWay}"
                         IsReadOnly="True" IsReadOnlyCaretVisible="True"
                         BorderThickness="0" Background="Transparent"
                         FontWeight="SemiBold" TextWrapping="Wrap"
                         AutomationProperties.Name="Subject"/>
                <TextBox x:Name="FromField"
                         Text="{Binding MessageDetail.From, FallbackValue='', Mode=OneWay}"
                         IsReadOnly="True" IsReadOnlyCaretVisible="True"
                         BorderThickness="0" Background="Transparent"
                         Margin="0,2,0,0"
                         AutomationProperties.Name="From"/>
                <TextBox x:Name="ToField"
                         Text="{Binding MessageDetail.To, FallbackValue='', Mode=OneWay}"
                         IsReadOnly="True" IsReadOnlyCaretVisible="True"
                         BorderThickness="0" Background="Transparent"
                         AutomationProperties.Name="To"/>
                <TextBox x:Name="CcField"
                         Text="{Binding MessageDetail.Cc, FallbackValue='', Mode=OneWay}"
                         IsReadOnly="True" IsReadOnlyCaretVisible="True"
                         BorderThickness="0" Background="Transparent"
                         AutomationProperties.Name="Cc">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageDetail.Cc}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MessageDetail.Cc}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBox x:Name="DateField"
                         Text="{Binding MessageDetail.Date, StringFormat='{}{0:f}', FallbackValue='', Mode=OneWay}"
                         IsReadOnly="True" IsReadOnlyCaretVisible="True"
                         BorderThickness="0" Background="Transparent"
                         AutomationProperties.Name="Date"/>

                <!-- Attachments -->
                <ListBox x:Name="AttachmentList"
                         ItemsSource="{Binding MessageDetail.Attachments}"
                         SelectionMode="Single"
                         BorderThickness="0"
                         Margin="0,4,0,0"
                         Visibility="{Binding MessageDetail.HasAttachments,
                                      Converter={StaticResource BoolToVisibilityConverter},
                                      FallbackValue=Collapsed}"
                         KeyboardNavigation.TabNavigation="Once"
                         KeyboardNavigation.DirectionalNavigation="Contained"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Attachments"
                         PreviewKeyDown="AttachmentList_PreviewKeyDown"
                         GotKeyboardFocus="AttachmentList_GotKeyboardFocus"
                         MouseDoubleClick="AttachmentList_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Size as visible text, not a tooltip (issue #825). Docked right so a long
                                 file name trims with an ellipsis instead of pushing the size off the row. The
                                 container's AccessibleName still reads "name, size". -->
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding FileSizeDisplay}"
                                           Style="{StaticResource RowSecondaryText}"
                                           Margin="8,0,4,0"/>
                                <TextBlock Text="{Binding FileName}"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="_Save…"
                                      Command="{Binding PlacementTarget.DataContext.SaveAttachmentCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Save _All…"
                                      Command="{Binding PlacementTarget.DataContext.SaveAllAttachmentsCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="_Open"
                                      Command="{Binding PlacementTarget.DataContext.OpenAttachmentCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Message body + loading overlay -->
        <Grid>
            <wv2:WebView2 x:Name="MessageBody"
                          AutomationProperties.Name="Message body"
                          KeyboardNavigation.IsTabStop="True"
                          GotKeyboardFocus="MessageBody_GotKeyboardFocus"/>
            <Border Background="{DynamicResource Theme.WindowBackground}"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                    IsHitTestVisible="False">
                <TextBlock Text="Loading…"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource Theme.FontSizeLarge}"
                           Foreground="{DynamicResource Theme.TextSecondary}"
                           AutomationProperties.LiveSetting="Polite"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
