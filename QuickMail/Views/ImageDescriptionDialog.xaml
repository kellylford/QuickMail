<Window x:Class="QuickMail.Views.ImageDescriptionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Description"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}"
        FontSize="{DynamicResource Theme.FontSizeBase}">
    <StackPanel Margin="12">
        <!-- Context only: which picture this is. Never used as the alt text. -->
        <TextBlock x:Name="FileText" TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource Theme.TextSecondary}"/>

        <Label x:Name="AltLabel" Content="_Alternative text:"
               Target="{Binding ElementName=AltBox}" Padding="0" Margin="0,0,0,4"/>
        <TextBox x:Name="AltBox"
                 AutomationProperties.LabeledBy="{Binding ElementName=AltLabel}"
                 TextWrapping="Wrap" AcceptsReturn="False"
                 MinHeight="48" Margin="0,0,0,8"
                 TextChanged="AltBox_TextChanged"/>

        <CheckBox x:Name="DecorativeBox" Content="_Decorative image (no description)"
                  Margin="0,0,0,6"
                  Checked="DecorativeBox_Changed" Unchecked="DecorativeBox_Changed"/>

        <CheckBox x:Name="ShrinkBox" Visibility="Collapsed" IsChecked="True"
                  Margin="0,0,0,6"/>

        <!-- Declaration order is tab order and visual order: Remove on the left,
             then OK and Cancel on the right. -->
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="RemoveButton" Grid.Column="0" Content="_Remove Image"
                    Visibility="Collapsed" MinWidth="100" Click="Remove_Click"/>
            <Button x:Name="OkButton" Grid.Column="2" Content="OK" IsDefault="True" IsEnabled="False"
                    MinWidth="80" Margin="0,0,6,0" Click="Ok_Click"/>
            <Button Grid.Column="3" Content="Cancel" MinWidth="80" Click="Cancel_Click"/>
        </Grid>
    </StackPanel>
</Window>
