<Window x:Class="QuickMail.Views.WatchedConversationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Watched Conversations"
        Width="640" Height="460"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}"
        FontSize="{DynamicResource Theme.FontSizeBase}">

    <DockPanel Margin="10">

        <!-- Button bar.
             NO access-key underscores on any Content here, deliberately. The list above has
             first-letter type-ahead, and WPF activates a bare mnemonic letter without Alt when
             focus is not in a text field — that is how "c" closed the folder picker (#418).
             Alt+G / Alt+R / Alt+S / Alt+C are wired explicitly in code-behind instead. -->
        <Border x:Name="ButtonBar" DockPanel.Dock="Bottom" Padding="0,10,0,0"
                KeyboardNavigation.TabNavigation="Continue">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="GoToButton"
                        Content="Go to Conversation"
                        Command="{Binding GoToCommand}"
                        MinWidth="140" Margin="0,0,6,0"
                        AutomationProperties.Name="Go to conversation"/>
                <Button x:Name="RenameButton"
                        Content="Rename"
                        Command="{Binding BeginRenameCommand}"
                        MinWidth="90" Margin="0,0,6,0"
                        AutomationProperties.Name="Rename"/>
                <Button x:Name="StopButton"
                        Content="Stop Watching"
                        Command="{Binding StopWatchingCommand}"
                        MinWidth="110" Margin="0,0,6,0"
                        AutomationProperties.Name="Stop watching"/>
                <Button x:Name="CloseButton"
                        Content="Close"
                        MinWidth="80"
                        AutomationProperties.Name="Close"/>
            </StackPanel>
        </Border>

        <!-- Status line -->
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom"
                   Text="{Binding Status}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Theme.TextSecondary}"
                   FontSize="{DynamicResource Theme.FontSizeSmall}"/>

        <!-- Rename panel: replaces nothing, sits under the list, shown only while renaming. -->
        <Border x:Name="EditPanel" DockPanel.Dock="Bottom" Padding="0,8,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <!-- Label, not TextBlock: Target carries the access key to the box and associates
                     the two so the box reports this as its name. Alt+L is safe here because it
                     only fires while this panel is shown and focus is in a text field. -->
                <Label Content="_Label" Target="{Binding ElementName=EditLabelBox}"
                       Padding="0" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <TextBox x:Name="EditLabelBox"
                         Text="{Binding EditLabel, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="200"
                         AutomationProperties.Name="Label"/>
                <TextBlock Text="{Binding RenameError}"
                           Foreground="{DynamicResource Theme.Error}"
                           FontSize="{DynamicResource Theme.FontSizeSmall}"
                           Margin="0,3,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RenameError}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Save"
                            Command="{Binding SaveRenameCommand}"
                            MinWidth="72" Margin="0,0,6,0"
                            AutomationProperties.Name="Save label"/>
                    <Button Content="Cancel"
                            Command="{Binding CancelRenameCommand}"
                            MinWidth="72"
                            AutomationProperties.Name="Cancel rename"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- The watch list. ListBox, never TreeView: WPF disables TextSearch on TreeView, which
             is how a type-ahead claim shipped doing nothing (#418). Registered in
             TypeAheadWiringTests.Sites. -->
        <ListBox x:Name="WatchList"
                 ItemsSource="{Binding Watches}"
                 SelectedItem="{Binding SelectedWatch, Mode=TwoWay}"
                 TextSearch.TextPath="Label"
                 KeyboardNavigation.TabNavigation="Once"
                 KeyboardNavigation.DirectionalNavigation="Contained"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Watched conversations">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="6,4"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontSize="{DynamicResource Theme.FontSizeSmall}"
                                   Foreground="{DynamicResource Theme.TextSecondary}">
                            <Run Text="{Binding CountText, Mode=OneWay}"/><Run Text=" · watched "/><Run Text="{Binding WatchedSince, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
