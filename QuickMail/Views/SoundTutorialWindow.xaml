<Window x:Class="QuickMail.Views.SoundTutorialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sound Tutorial"
        Height="460" Width="420"
        MinHeight="300" MinWidth="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Theme.WindowBackground}"
        Foreground="{DynamicResource Theme.TextPrimary}"
        FontFamily="{DynamicResource Theme.FontFamily}"
        FontSize="{DynamicResource Theme.FontSizeBase}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <DockPanel Margin="12">

        <TextBlock x:Name="IntroText" DockPanel.Dock="Top" Text="{Binding Intro}" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <Button x:Name="CloseButton" DockPanel.Dock="Bottom" Content="Close" MinWidth="85" Margin="0,10,0,0"
                HorizontalAlignment="Right" Click="CloseButton_Click"/>

        <TextBlock x:Name="NoteText" DockPanel.Dock="Bottom" Text="{Binding Note}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}"/>

        <DockPanel>
            <Label DockPanel.Dock="Top" Content="_Sound events:" Target="{Binding ElementName=SoundEventList}" Padding="0,0,0,2"/>
            <ListBox x:Name="SoundEventList" AutomationProperties.Name="Sound events"
                     ItemsSource="{Binding Rows}"
                     SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                     DisplayMemberPath="Label"
                     IsTextSearchEnabled="True" TextSearch.TextPath="Label"
                     PreviewKeyDown="SoundEventList_PreviewKeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
                        <EventSetter Event="MouseDoubleClick" Handler="SoundEventRow_MouseDoubleClick"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>

    </DockPanel>
</Window>
