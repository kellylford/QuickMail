<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:QuickMail.Controls">

    <!-- Visible keyboard focus ring for all controls.
         Theme.FocusIndicator resolves to the theme's high-visibility ring color
         (WindowText under Windows High Contrast); Theme.FocusThickness doubles
         when the "thicker focus indicators" setting is on. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <!-- Two-tone ring: a solid halo in the window background sits under the
                         dashed focus ring and extends 1px beyond it on each side. One of the
                         two colors always contrasts >=3:1 with whatever fill is underneath
                         (unit-enforced), so focus stays visible on selected rows too. -->
                    <Grid>
                        <Rectangle Margin="2"
                                   StrokeThickness="{DynamicResource Theme.FocusHaloThickness}"
                                   Stroke="{DynamicResource Theme.WindowBackground}"
                                   SnapsToDevicePixels="True"/>
                        <Rectangle Margin="2"
                                   StrokeThickness="{DynamicResource Theme.FocusThickness}"
                                   Stroke="{DynamicResource Theme.FocusIndicator}"
                                   StrokeDashArray="2 1"
                                   SnapsToDevicePixels="True"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Apply focus visual globally -->
    <Style TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinHeight" Value="28"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="IsExpanded" Value="True"/>
    </Style>

    <!-- Menu, ContextMenu, StatusBar and ToolTip take their font from WPF's default
         style for each type (the system menu/status font), and a default style beats
         the value a window passes down by inheritance — so without these four the menu
         bar and status bar ignore Settings → Appearance → Text size entirely (#691).
         Measured: in a window set to 20pt Comic Sans, Menu and StatusBar report their
         FontSize with BaseValueSource.DefaultStyle at 12pt Segoe UI, while ToolBar and
         ListBox report Inherited at 20pt. Setting the parent is enough — MenuItem and
         StatusBarItem report Inherited, so they follow it. ContextMenu and ToolTip are
         popup roots, which inherit nothing from their owner, and need their own.

         Colors are NOT set here. ThemedControls.xaml repeats these four setters
         alongside its colors, the way it repeats the Button setters above, and its
         copy wins wherever it is merged. This one exists for the case where it is
         NOT: under Windows High Contrast ThemeService withdraws ThemedControls so
         WPF's HC-aware templates take over, and the HC theme deliberately keeps the
         font and scale ("typography matters more to low-vision HC users",
         ThemeService.BuildHighContrastTheme). A colorless style leaves every color to
         the HC default style, exactly as an unset property should. -->
    <Style TargetType="Menu">
        <Setter Property="FontFamily" Value="{DynamicResource Theme.FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource Theme.FontSizeBase}"/>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{DynamicResource Theme.FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource Theme.FontSizeBase}"/>
    </Style>

    <Style TargetType="StatusBar">
        <Setter Property="FontFamily" Value="{DynamicResource Theme.FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource Theme.FontSizeBase}"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{DynamicResource Theme.FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource Theme.FontSizeBase}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Padding" Value="4,2"/>
    </Style>

    <!-- DateTimeField is a TextBox subclass, and implicit styles key on the exact type. Repeated
         here as well as in ThemedControls so the appointment editor's date and time fields keep a
         focus ring under Windows High Contrast, where ThemedControls is withdrawn. -->
    <Style TargetType="{x:Type controls:DateTimeField}" BasedOn="{StaticResource {x:Type TextBox}}"/>

    <!-- Column headers are mouse-clickable but never keyboard tab stops.
         Lives here (not only in ThemedControls) so the rule also holds under
         High Contrast, when ThemedControls is withdrawn. -->
    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <!-- Toolbar button style: Tab enters the toolbar from outside; Arrow keys navigate
         within it; Tab again exits.  Buttons are tab-stoppable so screen readers and
         keyboard users can reach them via standard Tab navigation. -->
    <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="75"/>
        <Setter Property="Margin" Value="2,0"/>
    </Style>

    <!-- Toolbar toggle button (e.g. Conversation view) — same sizing as ToolbarButton. -->
    <Style x:Key="ToolbarToggleButton" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="MinWidth" Value="75"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinHeight" Value="28"/>
    </Style>

    <!-- Status bar items — keyboard-focusable regions navigated with Left/Right arrows. -->

    <!-- Read-only TextBox used as the status bar text element.
         ControlType.Edit + ValuePattern means screen readers read its value
         natively when keyboard focus arrives (F6 pane cycling).
         Visually indistinguishable from a plain TextBlock, but focusable in UIA. -->
    <Style x:Key="StatusTextBoxStyle" TargetType="TextBox">
        <Setter Property="IsReadOnly"       Value="True"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="Padding"          Value="0"/>
        <Setter Property="Cursor"           Value="Arrow"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <!-- Override the default TextBox chrome so it looks like a label -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="border" Property="BorderBrush"
                                    Value="{DynamicResource Theme.FocusIndicator}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary text INSIDE a selectable row (a category under a command, a count
         under a conversation). Lives here rather than in ThemedControls.xaml because
         that dictionary is withdrawn under Windows High Contrast, and a StaticResource
         to a missing key is a XamlParseException at window construction.

         Neither of the two obvious ways to draw it is readable in every state, both
         measured from probe captures and from the theme JSON:

           - Theme.TextSecondary on its own reads 1.16:1 in Parchment once the row is
             selected, because the selection fill lands underneath it.
           - Dimming the inherited foreground with Opacity, which is what the command
             palette did (#702), reads 4.19:1 unselected in Parchment and 2.72:1 on the
             selected row in Dark. No opacity value fixes the second: Dark's
             selectionText on selectionBackground is only 4.61:1 at FULL opacity, so
             any dimming at all puts it under AA.

         So the secondary token is used only while the row is unselected, where it
         measures at least 5.8:1 in every built-in theme against all three fills an
         unselected row can have (window 7.7:1+, surface 7.3:1+, hover 5.8:1+).
         A selected row sets no foreground at all and
         inherits the container's, which the themed ListBoxItem template already gets
         right for both an active selection (Theme.SelectionText) and an inactive one
         (Theme.TextPrimary over Theme.SelectionInactive) - and which the command
         palette's own template, where the selection is never "active", also gets
         right. Both pairs are held to 4.5:1 by BuiltInThemeTests. The cost is that a
         selected row's secondary line is no longer dimmer than its first line; that is
         the only version of it that is legible in all five themes.

         If the ListBoxItem ancestor is missing the binding simply fails and the text
         inherits the primary foreground - readable, just not secondary. -->
    <Style x:Key="RowSecondaryText" TargetType="TextBlock">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                         Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- TextBlock styled as a focusable status bar display region.
         ControlType.Text has no ValuePattern, so screen readers announce
         only the text content once — not name + value separately. -->
    <Style x:Key="StatusTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="Cursor"           Value="Arrow"/>
        <Setter Property="Focusable"        Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
    </Style>

    <!-- Button styled to look like a status bar label.
         ControlType.Button + InvokePattern means screen readers announce
         "button" and users know they can activate it with Enter/Space.
         Visually indistinguishable from the read-only TextBox regions. -->
    <Style x:Key="StatusBarButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Background"       Value="Transparent"/>
        <!-- The status bar's own themed text colour, stated here because a Button's default style sets the
             system control-text colour, which beats the colour the StatusBar passes down: the text was
             black in every theme, 1.56:1 on the dark status bar (#689). -->
        <Setter Property="Foreground" Value="{DynamicResource Theme.TextPrimary}"/>
        <Setter Property="Padding"          Value="0"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="border" Property="BorderBrush"
                                    Value="{DynamicResource Theme.FocusIndicator}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background"
                                    Value="{DynamicResource Theme.AccentSubtle}"/>
                        </Trigger>
                        <!-- The selection pair, as the themed Button uses when pressed: the theme's text colour
                             on Theme.Border measured 3.5-4.0:1, below AA while the button was held. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background"
                                    Value="{DynamicResource Theme.SelectionBackground}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Theme.SelectionText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Invisible spacer that consumes all remaining horizontal space,
         pushing subsequent StatusBarItems to the right edge. -->
    <Style x:Key="StatusBarSpacerStyle" TargetType="Separator">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Width="Auto" Height="0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
