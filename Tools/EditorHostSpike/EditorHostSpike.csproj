<Project Sdk="Microsoft.NET.Sdk">
  <!-- Stage 1 of #1099: can QuickMail's WPF compose window host WinUI 3's RichEditBox as its body?
       A standalone spike, not part of QuickMail.sln. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AssemblyName>EditorHostSpike</AssemblyName>
    <RootNamespace>EditorHostSpike</RootNamespace>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Unpackaged, carrying its own copy of the Windows App SDK, as QuickMail would. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- WinUI's control styles come from resource index files (.pri) beside the exe. -->
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>
  <ItemGroup>
    <!-- Only the WinUI part of the Windows App SDK. The whole SDK (Microsoft.WindowsAppSDK) adds
         about 50 MB of AI and ML libraries QuickMail has no use for, and its single-file exe
         doesn't start: its manifest names SessionHandleIPCProxyStub.dll twice, and Windows
         refuses it ("side-by-side configuration is incorrect"). -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.*" />
    <!-- As QuickMail: vpk pack refuses an exe whose Main doesn't run VelopackApp first. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
</Project>
